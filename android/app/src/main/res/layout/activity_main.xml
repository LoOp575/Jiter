<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jiter_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Minimal Top Bar: Brand (5-tap hidden developer console) + ID/EN switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:letterSpacing="0.18"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/app_name"
            android:textColor="@color/jiter_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleLanguage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/lang_switch_id"
            android:textColor="@color/jiter_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/jiter_stroke" />
    </LinearLayout>

    <!-- Center Hero: Signature Vertical Line | + Single Big GO/STOP Button + Human Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Signature single vertical line indicator | -->
        <View
            android:id="@+id/statusLineIndicator"
            android:layout_width="10dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_status_line" />

        <!-- Primary One-Tap GO / STOP Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoStop"
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/jiter_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.16"
            android:text="@string/action_go"
            android:textColor="@color/jiter_bg"
            android:textSize="32sp"
            android:textStyle="bold"
            android:elevation="6dp"
            app:cornerRadius="86dp" />

        <!-- Human-friendly single status line -->
        <TextView
            android:id="@+id/tvMainStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/main_status_ready"
            android:textColor="@color/jiter_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtle Auto-Detected Mode Pill (visible while active) -->
        <TextView
            android:id="@+id/tvActivityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_activity_badge"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/jiter_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Calm Secondary Line -->
        <TextView
            android:id="@+id/tvMainSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:text="@string/main_subtitle_idle"
            android:textColor="@color/jiter_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Minimal Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/main_footer_hint"
        android:textColor="@color/jiter_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
